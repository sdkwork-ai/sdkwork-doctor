{
  "name": "@sdkwork/doctor-pc-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SDKWork Doctor PC core runtime: composition registries, host adapters, and session ports.",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./sdk": {
      "types": "./src/sdk/index.ts",
      "import": "./src/sdk/index.ts",
      "default": "./src/sdk/index.ts"
    },
    "./agent": {
      "types": "./src/agent/index.ts",
      "import": "./src/agent/index.ts",
      "default": "./src/agent/index.ts"
    },
    "./modules": {
      "types": "./src/modules/index.ts",
      "import": "./src/modules/index.ts",
      "default": "./src/modules/index.ts"
    },
    "./host": {
      "types": "./src/host/index.ts",
      "import": "./src/host/index.ts",
      "default": "./src/host/index.ts"
    },
    "./session": {
      "types": "./src/session/index.ts",
      "import": "./src/session/index.ts",
      "default": "./src/session/index.ts"
    },
    "./composition": {
      "types": "./src/composition/index.ts",
      "import": "./src/composition/index.ts",
      "default": "./src/composition/index.ts"
    }
  },
  "dependencies": {
    "@sdkwork/doctor-common-agent": "workspace:*",
    "@sdkwork/doctor-common-diagnostics": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "sdkwork": {
    "workspace": "sdkwork-doctor",
    "product": "sdkwork-doctor",
    "architecture": "pc",
    "domain": "platform",
    "capability": "core",
    "status": "scaffold"
  }
}
