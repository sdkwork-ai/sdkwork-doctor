<view class="card">
  <view class="h1">{{title}}</view>
  <view class="muted">{{subtitle}}</view>
  <view wx:for="{{rows}}" wx:key="label" class="row">
    <text>{{item.label}}</text>
    <text>{{item.value}}</text>
  </view>
</view>
<view class="card">
  <view class="h1">{{actions}}</view>
  <view class="muted">{{hint}}</view>
</view>
