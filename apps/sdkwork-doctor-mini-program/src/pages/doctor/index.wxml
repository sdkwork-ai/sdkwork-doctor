<view class="card">
  <view class="row">
    <text class="h1">{{aiTitle}}</text>
    <text class="badge">{{aiStatus}}</text>
  </view>
  <view class="muted">{{aiHint}}</view>
</view>

<view class="card">
  <view class="h1">{{mineTitle}}</view>
  <view class="row">
    <text>{{countLabel}}</text>
    <text class="badge">{{sourceLabel}}</text>
  </view>
  <view wx:if="{{mine.length === 0}}" class="muted">{{mineEmpty}}</view>
  <view wx:for="{{mine}}" wx:key="id" class="file">
    <view class="row">
      <text>{{item.name}}</text>
      <text wx:if="{{item.primary}}" class="badge">{{item.primaryLabel}}</text>
      <button wx:else class="mini" data-id="{{item.id}}" bindtap="onSetPrimary">{{item.setPrimaryLabel}}</button>
    </view>
    <view class="muted">{{item.site}}</view>
  </view>
  <button class="btn ghost" bindtap="onClearSelection" disabled="{{mine.length === 0}}">{{clearLabel}}</button>
</view>

<view class="card">
  <view class="h1">{{chooseTitle}}</view>
  <view class="muted">{{chooseHint}}</view>
  <view class="muted">{{limitLabel}}</view>
  <view wx:if="{{loading}}" class="muted">{{loadingLabel}}</view>
  <view wx:if="{{doctors.length === 0}}" class="muted">{{emptyLabel}}</view>
  <view wx:for="{{doctors}}" wx:key="id" class="doctor">
    <view class="row">
      <text>{{item.name}}</text>
      <text wx:if="{{item.primary}}" class="badge">{{primaryLabel}}</text>
    </view>
    <view class="muted">{{item.rank}} · {{item.department}} · {{item.hospital}}</view>
    <view class="badges">
      <text class="badge {{item.verified ? '' : 'warn'}}">{{item.verifiedLabel}}</text>
      <text class="badge {{item.accepting ? '' : 'warn'}}">{{item.acceptingLabel}}</text>
      <text class="badge">{{item.employment}}</text>
    </view>
    <view wx:if="{{item.otherAffiliations}}" class="muted">{{item.otherAffiliations}}</view>
    <view class="muted">{{specialtiesLabel}}: {{item.specialties}}</view>
    <view class="muted">{{languagesLabel}}: {{item.languages}}</view>
    <view class="muted">{{item.experience}}</view>
    <view class="muted">{{availabilityLabel}}: {{item.availability}}</view>
    <view class="actions">
      <button class="btn" data-id="{{item.id}}" bindtap="onToggleDoctor">{{item.selected ? selectedLabel : selectLabel}}</button>
      <button class="btn ghost" data-id="{{item.id}}" bindtap="onOpenConsult">{{consultLabel}}</button>
    </view>
  </view>
</view>

<view class="card" wx:if="{{consultOpen}}">
  <view class="h1">{{consultLabel}}</view>
  <view class="row">
    <text>{{consultDoctorName}}</text>
    <text class="badge">{{consultChannelLabel}}</text>
  </view>
  <view class="muted">{{consultHint}}</view>
  <view wx:if="{{consultAffiliationLabels.length > 1}}">
    <view class="label">{{affiliationsTitle}}</view>
    <view class="muted">{{consultAffiliationsHint}}</view>
    <picker
      mode="selector"
      range="{{consultAffiliationLabels}}"
      value="{{consultAffiliationIndex}}"
      bindchange="onAffiliationChange"
    >
      <view class="row"><text>{{chooseAffiliationLabel}}</text><text>{{consultAffiliationLabel}}</text></view>
    </picker>
  </view>
  <view wx:if="{{consultAffiliationLabels.length === 1}}" class="row">
    <text>{{chooseAffiliationLabel}}</text>
    <text>{{consultAffiliationLabel}}</text>
  </view>
  <view wx:if="{{consultOrganization}}" class="muted">{{organizationLabel}}: {{consultOrganization}}</view>
  <view wx:if="{{consultHospitalCode}}" class="muted">{{hospitalCodeLabel}}: {{consultHospitalCode}}</view>
  <view wx:if="{{consultSince}}" class="muted">{{consultSince}}</view>
  <view class="row">
    <text>{{employmentTitle}}</text>
    <text class="badge">{{consultEmployment}}</text>
  </view>
  <view wx:if="{{!consultHasChannel}}" class="muted">{{noChannelLabel}}</view>
  <view wx:if="{{!consultHasPatient}}" class="muted">{{noPatientLabel}}</view>
  <view class="label">{{consultReasonLabel}}</view>
  <textarea
    class="textarea"
    value="{{consultReason}}"
    bindinput="onReasonInput"
    placeholder="{{consultReasonLabel}}"
    maxlength="200"
    disabled="{{!consultHasChannel || !consultHasPatient}}"
  />
  <view wx:if="{{consultStatus}}" class="muted">{{consultStatus}}</view>
  <view wx:if="{{consultError}}" class="error">{{consultError}}</view>
  <view class="actions">
    <button class="btn" bindtap="onSubmitConsult" disabled="{{!consultReady}}">{{consultLabel}}</button>
    <button class="btn ghost" bindtap="onCancelConsult">{{cancelLabel}}</button>
  </view>
</view>
