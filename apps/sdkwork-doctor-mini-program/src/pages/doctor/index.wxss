/* Doctor tab: flat tech-blue roster cards and the human-consult form. */
.doctor,
.file {
  background: #e6edf8;
  border-radius: 10px;
  padding: 10px 12px;
  margin: 8px 0;
}

.badges {
  display: flex;
  margin: 6px 0;
}

.badges .badge {
  margin-right: 8px;
}

.actions {
  display: flex;
  margin-top: 10px;
}

.actions .btn {
  flex: 1;
  margin-right: 8px;
  text-align: center;
}

.btn.ghost {
  background: #e6edf8;
  color: #0a5cff;
}

.mini {
  background: #e6edf8;
  color: #0a5cff;
  border-radius: 999px;
  padding: 4px 10px;
  font-size: 12px;
  line-height: 1.4;
}

.label {
  margin-top: 10px;
  font-size: 13px;
  color: #0a1324;
  font-weight: 600;
}

.textarea {
  width: 100%;
  box-sizing: border-box;
  background: #e6edf8;
  border: 0;
  border-radius: 10px;
  padding: 10px;
  margin-top: 8px;
  min-height: 76px;
  font-size: 14px;
  color: #0a1324;
}
