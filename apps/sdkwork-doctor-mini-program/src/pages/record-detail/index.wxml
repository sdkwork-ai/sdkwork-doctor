<view wx:if="{{!session}}" class="card">
  <text class="link" bindtap="onBack">← {{backLabel}}</text>
  <view class="muted">{{notFound}}</view>
</view>

<block wx:else>
  <view class="card">
    <text class="link" bindtap="onBack">← {{backLabel}}</text>
    <view class="row">
      <text class="h1">{{session.title}}</text>
      <text class="badge {{statusTone}}">{{statusLabel}}</text>
    </view>
    <view class="muted">
      {{session.member}} · {{session.startedAt}}<block wx:if="{{session.endedAt}}"> — {{session.endedAt}}</block>
    </view>
  </view>

  <!-- The four tabs: 病历 / AI总结 / 医生人工确认 / 通话回放. -->
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'on' : ''}}"
      data-tab="{{item.key}}"
      bindtap="onTab"
    >{{item.label}}</view>
  </view>

  <block wx:if="{{activeTab === 'medical'}}">
    <view class="card">
      <view class="muted">{{labels.visitTime}}</view>
      <view class="fact"><text class="muted">{{labels.member}}</text><text>{{session.member}}</text></view>
      <view class="fact"><text class="muted">{{labels.visitTime}}</text><text>{{session.startedAt}}</text></view>
      <view class="fact"><text class="muted">{{labels.duration}}</text><text>{{session.duration}}</text></view>
      <view class="fact"><text class="muted">{{labels.mode}}</text><text>{{session.mode}}</text></view>
      <view class="fact"><text class="muted">{{labels.status}}</text><text>{{statusLabel}}</text></view>
      <view class="fact"><text class="muted">{{labels.doctor}}</text><text>{{record.doctorLabel || labels.doctorUnassigned}}</text></view>
    </view>

    <view wx:if="{{active}}" class="card">
      <view class="notice">{{recordPending}}</view>
    </view>

    <view wx:if="{{chiefComplaint}}" class="card">
      <view class="muted">{{labels.chiefComplaint}}</view>
      <view>{{chiefComplaint}}</view>
    </view>

    <view class="card">
      <view class="muted">{{labels.transcript}}</view>
      <view class="muted">{{recordHint}}</view>
      <view wx:if="{{transcript.length === 0}}" class="muted">{{labels.transcriptEmpty}}</view>
      <view wx:for="{{transcript}}" wx:for-item="entry" wx:key="id" class="message">
        <view class="row">
          <text>{{entry.role}}</text>
          <text class="muted">{{entry.channel}} · {{entry.time}}</text>
        </view>
        <view wx:if="{{entry.level}}" class="badge {{entry.warn ? 'warn' : ''}}">{{entry.level}}</view>
        <view wx:if="{{entry.text}}" class="muted">{{entry.text}}</view>
        <view wx:for="{{entry.attachments}}" wx:for-item="file" wx:key="id" class="attachment">
          <image
            wx:if="{{file.kind === 'image' && (file.path || file.dataUrl)}}"
            class="attachment-image"
            mode="aspectFill"
            src="{{file.path || file.dataUrl}}"
          />
          <video
            wx:elif="{{file.kind === 'video' && file.path}}"
            class="attachment-video"
            controls="{{true}}"
            src="{{file.path}}"
          />
          <view wx:else class="attachment-file" data-path="{{file.path}}" bindtap="onOpenAttachment">{{file.name}}</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="muted">{{labels.attachments}}</view>
      <view wx:if="{{attachments.length === 0}}" class="muted">{{labels.attachmentsEmpty}}</view>
      <view wx:for="{{attachments}}" wx:for-item="file" wx:key="id" class="attachment">
        <image
          wx:if="{{file.kind === 'image' && (file.path || file.dataUrl)}}"
          class="attachment-image"
          mode="aspectFill"
          src="{{file.path || file.dataUrl}}"
        />
        <video
          wx:elif="{{file.kind === 'video' && file.path}}"
          class="attachment-video"
          controls="{{true}}"
          src="{{file.path}}"
        />
        <view wx:else class="attachment-file" data-path="{{file.path}}" bindtap="onOpenAttachment">{{file.name}}</view>
        <text class="muted">{{file.name}} · {{file.sizeLabel}}</text>
      </view>
    </view>
  </block>

  <block wx:elif="{{activeTab === 'ai'}}">
    <view wx:if="{{!record}}" class="card">
      <view class="muted">{{aiPending}}</view>
    </view>
    <block wx:else>
      <view class="card">
        <view class="muted">{{aiHint}}</view>
        <view class="summary">{{record.summary}}</view>
      </view>
      <view class="card">
        <view class="row">
          <text>{{labels.aiDiagnosis}}</text>
          <text class="badge {{record.ai.warn ? 'warn' : ''}}">{{record.ai.level}}</text>
        </view>
        <view class="muted">{{labels.aiDiagnosisHint}}</view>
        <view class="muted">{{labels.impression}}: {{record.ai.impression}}</view>
        <view wx:if="{{record.ai.conditions}}" class="muted">{{labels.conditions}}: {{record.ai.conditions}}</view>
        <view wx:for="{{record.ai.recommendations}}" wx:for-item="line" wx:key="*this" class="muted">· {{line}}</view>
        <view wx:if="{{record.ai.notes}}" class="muted">{{labels.notes}}: {{record.ai.notes}}</view>
        <view class="muted">{{record.ai.createdAtLabel}}</view>
      </view>
    </block>
  </block>

  <block wx:elif="{{activeTab === 'doctor'}}">
    <view wx:if="{{!record}}" class="card">
      <view class="muted">{{doctorPending}}</view>
    </view>
    <block wx:else>
      <view class="card">
        <view class="muted">{{labels.confirmationStatus}}</view>
        <view class="muted">{{doctorHint}}</view>
        <view class="row">
          <text>{{record.statusLabel}}</text>
          <text class="badge {{record.statusWarn ? 'warn' : ''}}">{{record.statusWarn ? labels.confirmationStatus : labels.saved}}</text>
        </view>
        <view wx:if="{{record.confirmationLabel}}" class="muted">{{record.confirmationLabel}}</view>
      </view>

      <view class="card">
        <view class="row">
          <text>{{labels.aiDiagnosis}}</text>
          <text class="badge {{record.ai.warn ? 'warn' : ''}}">{{record.ai.level}}</text>
        </view>
        <view class="muted">{{labels.aiDiagnosisHint}}</view>
        <view class="muted">{{labels.impression}}: {{record.ai.impression}}</view>
        <view wx:if="{{record.ai.conditions}}" class="muted">{{labels.conditions}}: {{record.ai.conditions}}</view>
        <view wx:for="{{record.ai.recommendations}}" wx:for-item="line" wx:key="*this" class="muted">· {{line}}</view>
      </view>

      <view class="card">
        <view class="row">
          <text>{{labels.doctorDiagnosis}}</text>
          <text wx:if="{{record.doctorDiagnosis}}" class="badge {{record.doctorDiagnosis.warn ? 'warn' : ''}}">{{record.doctorDiagnosis.level}}</text>
        </view>
        <view class="muted">{{labels.doctorDiagnosisHint}}</view>
        <block wx:if="{{record.doctorDiagnosis}}">
          <view class="muted">{{labels.impression}}: {{record.doctorDiagnosis.impression}}</view>
          <view wx:if="{{record.doctorDiagnosis.conditions}}" class="muted">{{labels.conditions}}: {{record.doctorDiagnosis.conditions}}</view>
          <view wx:for="{{record.doctorDiagnosis.recommendations}}" wx:for-item="line" wx:key="*this" class="muted">· {{line}}</view>
          <view wx:if="{{record.doctorDiagnosis.notes}}" class="muted">{{labels.notes}}: {{record.doctorDiagnosis.notes}}</view>
          <view class="muted">{{record.doctorDiagnosis.doctorLabel}} · {{record.doctorDiagnosis.createdAtLabel}}</view>
        </block>
        <view wx:else class="muted">{{labels.noDoctorDiagnosis}}</view>
      </view>

      <view wx:if="{{review}}" class="card">
        <view class="muted">{{labels.review}}</view>
        <view class="muted">{{labels.reviewHint}}</view>
        <view class="muted">{{labels.doctorLabel}}</view>
        <input
          class="input"
          data-field="doctorLabel"
          placeholder="{{labels.doctorPlaceholder}}"
          value="{{review.doctorLabel}}"
          bindinput="onReviewInput"
        />
        <view class="chips">
          <view class="chip {{review.mode === 'confirm' ? 'on' : ''}}" data-mode="confirm" bindtap="onReviewMode">{{labels.confirmAi}}</view>
          <view class="chip {{review.mode === 'amend' ? 'on' : ''}}" data-mode="amend" bindtap="onReviewMode">{{labels.amendAi}}</view>
          <view class="chip {{review.mode === 'manual' ? 'on' : ''}}" data-mode="manual" bindtap="onReviewMode">{{labels.addDoctorDiagnosis}}</view>
        </view>
        <block wx:if="{{review.mode !== 'confirm'}}">
          <view class="muted">{{labels.impression}}</view>
          <textarea class="input" data-field="impression" value="{{review.impression}}" bindinput="onReviewInput" />
          <view class="muted">{{labels.conditions}}</view>
          <textarea class="input" data-field="conditions" value="{{review.conditions}}" bindinput="onReviewInput" />
          <view class="muted">{{labels.recommendations}}</view>
          <textarea class="input" data-field="recommendations" value="{{review.recommendations}}" bindinput="onReviewInput" />
          <picker mode="selector" range="{{levelLabels}}" value="{{review.levelIndex}}" bindchange="onLevelChange">
            <view class="row">
              <text>{{labels.level}}</text>
              <text class="muted">{{levelLabels[review.levelIndex]}}</text>
            </view>
          </picker>
          <view class="muted">{{labels.notes}}</view>
          <textarea class="input" data-field="notes" value="{{review.notes}}" bindinput="onReviewInput" />
        </block>
        <view wx:if="{{reviewError}}" class="error">{{reviewError}}</view>
        <view wx:if="{{notice}}" class="notice">{{notice}}</view>
        <button class="btn" bindtap="onSaveReview">{{labels.save}}</button>
      </view>
    </block>
  </block>

  <block wx:elif="{{activeTab === 'playback'}}">
    <view class="card">
      <view class="muted">{{playbackHint}}</view>
      <view class="muted">{{playbackUnavailable}}</view>
      <view class="playback-controls">
        <button class="btn" bindtap="togglePlayback">{{playing ? labels.pause : labels.play}}</button>
        <button class="btn btn-quiet" bindtap="onStopPlayback">{{labels.stop}}</button>
        <button class="btn btn-quiet" bindtap="onReplay">{{labels.replay}}</button>
      </view>
      <view wx:if="{{playbackNotice}}" class="notice">{{playbackNotice}}</view>
      <view class="progress"><view class="progress-fill" style="width: {{playbackProgress}}%"></view></view>
      <view wx:if="{{playbackLabel}}" class="muted">{{playbackLabel}}</view>
    </view>

    <view class="card">
      <view wx:if="{{playback.length === 0}}" class="muted">{{playbackEmpty}}</view>
      <block wx:for="{{playback}}" wx:key="id">
        <view wx:if="{{item.kind === 'call'}}" class="call-marker">
          <text class="badge skipped">{{item.label}}</text>
          <text class="muted">{{item.meta}}</text>
        </view>
        <view
          wx:else
          class="message {{playbackIndex === index ? 'active' : ''}}"
          data-index="{{index}}"
          bindtap="onSelectPlayback"
        >
          <view class="row">
            <text>{{item.role}}</text>
            <text class="muted">{{item.channel}} · {{item.offset}}</text>
          </view>
          <view wx:if="{{item.level}}" class="badge {{item.warn ? 'warn' : ''}}">{{item.level}}</view>
          <view class="muted">{{item.text}}</view>
        </view>
      </block>
    </view>
  </block>
</block>
