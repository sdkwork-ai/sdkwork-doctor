/* Patient switcher: one flat tech-blue chip per profile file. */
.chips {
  white-space: nowrap;
  margin: 8px 0;
  width: 100%;
}

.chip {
  display: inline-block;
  padding: 7px 14px;
  margin-right: 8px;
  border-radius: 999px;
  background: #e6edf8;
  color: #0a1324;
  font-size: 13px;
}

.chip.on {
  background: #0a5cff;
  color: #ffffff;
  font-weight: 600;
}

/* 对话: the transcript scrolls under the page chrome while the shared
   conversation composer stays docked above the native tab bar. */
.conversation {
  padding-bottom: 300rpx;
}

/* End-of-conversation bar: the patient ends the session above the transcript. */
.session-bar {
  background: #e6edf8;
  border-radius: 10px;
  padding: 10px 12px;
  margin: 10px 0;
}

.session-bar .btn {
  width: 100%;
  margin-top: 8px;
}

.notice {
  background: #e3f7ef;
  color: #0e9f6e;
  border-radius: 10px;
  padding: 8px 10px;
  margin-top: 8px;
  font-size: 12px;
}

/* Attachments: uploaded images, videos, and documents shown with the turn. */
.attachment {
  display: flex;
  flex-direction: column;
  margin: 8px 0;
}

.attachment-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 10px;
}

.attachment-video {
  width: 100%;
  border-radius: 10px;
}

.attachment-file {
  background: #e6edf8;
  border-radius: 10px;
  padding: 10px 12px;
  color: #0a5cff;
  font-size: 13px;
}

.attachment-list {
  margin-top: 10px;
}

.attachment-chip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #e6edf8;
  border-radius: 10px;
  padding: 8px 10px;
  margin-bottom: 6px;
}

.attachment-chip .remove {
  color: #e5484d;
  font-size: 12px;
}

.composer-dock {
  background: #f2f5fa;
  bottom: 0;
  left: 0;
  padding-top: 12rpx;
  position: fixed;
  right: 0;
  z-index: 20;
}

/* Conversation list trigger and its unread count. */
.session-trigger {
  align-items: center;
  background: #e6edf8;
  border-radius: 999px;
  color: #0747c9;
  display: flex;
  font-size: 12px;
  font-weight: 600;
  gap: 8rpx;
  padding: 8rpx 20rpx;
}

.unread {
  background: #e5484d;
  border-radius: 999px;
  color: #ffffff;
  font-size: 11px;
  font-weight: 700;
  min-width: 32rpx;
  padding: 2rpx 10rpx;
  text-align: center;
}

/* A human consultation: who the family is talking to and its state. */
.human-bar {
  background: #e6edf8;
  border-radius: 10px;
  margin: 10px 0;
  padding: 10px 12px;
}

.human-bar .strong {
  margin-top: 6rpx;
}

.human-bar .btn {
  margin-top: 8px;
}

/* The conversation list and the doctor reply share one bottom sheet. */
.sheet-backdrop {
  align-items: flex-end;
  background: rgba(6, 26, 58, 0.42);
  bottom: 0;
  display: flex;
  left: 0;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 40;
}

.sheet {
  background: #f2f5fa;
  border-radius: 22rpx 22rpx 0 0;
  max-height: 80vh;
  overflow-y: auto;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  width: 100%;
}

.sheet .h1 {
  font-size: 18px;
  font-weight: 700;
}

.sheet .close {
  color: #5a6b85;
  font-size: 22px;
  padding: 0 6rpx;
}

.session-row {
  background: #ffffff;
  border-radius: 12rpx;
  margin-top: 12rpx;
  padding: 16rpx;
}

.session-row.on {
  background: #dbe7ff;
}

.sheet .reply-input {
  background: #ffffff;
  border-radius: 12rpx;
  font-size: 14px;
  margin: 16rpx 0;
  min-height: 180rpx;
  padding: 16rpx;
  width: 100%;
}
