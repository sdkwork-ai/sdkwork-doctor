<view class="card"><view class="h1">Family doctor chat</view><view class="muted">Emergency red flags are escalated before any reply.</view><view wx:for="{{messages}}" wx:key="id" class="row"><text>{{item.role}}: {{item.text}}</text></view><view style="display:flex;margin-top:12px"><input class="input" value="{{draft}}" bindinput="onInput" placeholder="Describe a symptom"/><button class="btn" bindtap="onSend">Send</button></view></view>
