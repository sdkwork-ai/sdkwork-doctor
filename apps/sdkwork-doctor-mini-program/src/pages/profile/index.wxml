<view class="me-identity">
  <view class="me-identity-main" bindtap="onOpenPatients">
    <view class="me-avatar">{{initial}}</view>
    <view class="me-identity-copy">
      <view class="me-name">{{activeName}}</view>
      <view class="me-id">{{activeMeta}}</view>
    </view>
    <text class="chevron">›</text>
  </view>
  <view class="me-pills">
    <text wx:if="{{completeness}}" class="me-pill">{{completeness}}</text>
    <text class="me-pill"><text class="pill-dot {{modeTone}}"></text>{{modeLabel}}</text>
  </view>
</view>

<view class="me-groups">
  <view class="me-group">
    <view class="cell" bindtap="onOpenPatients">
      <image class="cell-icon" src="../../assets/icons/patients.png"></image>
      <text class="cell-title">{{patientsTitle}}</text>
      <text class="cell-value">{{patientsValue}}</text>
      <text class="chevron">›</text>
    </view>
    <view class="cell" bindtap="onOpenDoctors">
      <image class="cell-icon" src="../../assets/icons/doctors.png"></image>
      <text class="cell-title">{{doctorsTitle}}</text>
      <text class="cell-value">{{doctorsValue}}</text>
      <text class="chevron">›</text>
    </view>
  </view>

  <view class="me-group">
    <view class="cell" bindtap="onOpenChat">
      <image class="cell-icon" src="../../assets/icons/chat.png"></image>
      <text class="cell-title">{{chatTitle}}</text>
      <text class="chevron">›</text>
    </view>
    <view class="cell" bindtap="onOpenRecords">
      <image class="cell-icon" src="../../assets/icons/records.png"></image>
      <text class="cell-title">{{recordsTitle}}</text>
      <text class="cell-value">{{recordsValue}}</text>
      <text class="chevron">›</text>
    </view>
  </view>

  <view class="me-group">
    <view class="cell" bindtap="onOpenDevice">
      <image class="cell-icon" src="../../assets/icons/device.png"></image>
      <text class="cell-title">{{deviceTitle}}</text>
      <text class="chevron">›</text>
    </view>
  </view>
</view>

<view class="me-footnote">{{privacy}}</view>
