/* Tech-blue, flat, borderless. Values pinned by specs/design-tokens.contract.json. */
page {
  background: #f2f5fa;
  color: #0a1324;
  font-family: 'Inter', system-ui, -apple-system, sans-serif;

  /* Shared conversation composer (appbase projection) bound to the tokens. */
  --sdkwork-chat-composer-accent: #0a5cff;
  --sdkwork-chat-composer-chip: #e6edf8;
  --sdkwork-chat-composer-disabled-control: #e6edf8;
  --sdkwork-chat-composer-foreground: #0a1324;
  --sdkwork-chat-composer-on-accent: #ffffff;
  --sdkwork-chat-composer-placeholder: #5a6b85;
  --sdkwork-chat-composer-radius-card: 14px;
  --sdkwork-chat-composer-surface: #ffffff;
}

.card {
  background: #ffffff;
  border: 0;
  border-radius: 14px;
  padding: 16px;
  margin: 12px;
}

.h1 { font-size: 20px; font-weight: 600; margin: 4px 0; color: #0a1324; }
.muted { color: #5a6b85; font-size: 13px; line-height: 1.6; }

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 12px;
  margin: 6px 0;
  border-radius: 10px;
  background: #e6edf8;
  font-size: 14px;
}

.record {
  background: #e6edf8;
  border-radius: 10px;
  padding: 10px 12px;
  margin: 8px 0;
}

/* Doctor portraits and the identity rows that carry them. The roster's portrait
   is already transparent outside its circle, so no border and no shadow. */
.person { display: flex; align-items: flex-start; margin: 6px 0; }
.avatar { width: 48px; height: 48px; border-radius: 50%; flex: 0 0 auto; margin-right: 10px; background: #e6edf8; }
.avatar-lg { width: 56px; height: 56px; }
.avatar-fallback { display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 600; color: #0a5cff; }
.person-copy { flex: 1; min-width: 0; }
.person-head { display: flex; align-items: center; justify-content: space-between; }
.person-name { font-size: 15px; font-weight: 600; color: #0a1324; }

.badge {
  padding: 3px 9px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 600;
  background: #e3f7ef;
  color: #0e9f6e;
}
.badge.warn { background: #fff4e0; color: #b26a00; }

.input {
  flex: 1;
  background: #e6edf8;
  border: 0;
  border-radius: 10px;
  padding: 10px;
  margin-right: 8px;
  color: #0a1324;
}

.btn {
  background: #0a5cff;
  color: #ffffff;
  border-radius: 10px;
  padding: 10px 16px;
  font-size: 14px;
  font-weight: 600;
}
.btn[disabled] { opacity: 0.55; }

.error { color: #e5484d; font-size: 12px; }

/* 病历: AI diagnosis and doctor diagnosis are rendered as two independent
   blocks, plus the review form the doctor saves. */
.notice {
  background: #e3f7ef;
  color: #0e9f6e;
  border-radius: 10px;
  padding: 8px 10px;
  margin: 8px 0;
  font-size: 12px;
}

.diagnosis {
  background: #e6edf8;
  border-radius: 10px;
  padding: 10px 12px;
  margin: 8px 0;
}

.review {
  margin-top: 10px;
}

.review .input {
  width: 100%;
  box-sizing: border-box;
  margin: 6px 0 10px;
}

.link {
  color: #0a5cff;
  font-size: 13px;
  font-weight: 600;
}

/* 我的: a full-bleed account screen. The identity block (avatar, name, facts,
   status pills) sits directly on the canvas; each capability below is one row
   of a grouped list, separated from its siblings by a 1px tonal inset that
   starts where the text starts. */
.me-identity { padding: 16px 16px 0; }

.me-identity-main { display: flex; align-items: center; }

.me-avatar {
  width: 64px;
  height: 64px;
  flex: 0 0 64px;
  border-radius: 16px;
  background: #e7efff;
  color: #0747c9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26px;
  font-weight: 700;
}

.me-identity-copy { flex: 1; min-width: 0; margin-left: 16px; }
.me-name { font-size: 22px; font-weight: 600; color: #0a1324; }
.me-id { margin-top: 5px; font-size: 13px; line-height: 1.4; color: #5a6b85; }

.me-pills { display: flex; flex-wrap: wrap; margin: 14px 0 0 80px; }
.me-pill {
  display: inline-flex;
  align-items: center;
  margin-right: 8px;
  padding: 6px 12px;
  border-radius: 999px;
  background: #ffffff;
  font-size: 12px;
  color: #5a6b85;
}
.pill-dot { width: 6px; height: 6px; border-radius: 50%; background: #0e9f6e; margin-right: 6px; }
.pill-dot.muted { background: #5a6b85; }

.me-groups { margin-top: 24px; }
.me-group { display: flex; flex-direction: column; background: #ffffff; margin-bottom: 10px; }

.cell { position: relative; display: flex; align-items: center; padding: 16px; background: #ffffff; }
.cell + .cell::before {
  content: '';
  position: absolute;
  top: 0;
  left: 52px;
  right: 0;
  height: 1px;
  background: #e6edf8;
}

.cell-icon { width: 20px; height: 20px; flex: 0 0 20px; }
.cell-title { flex: 1; min-width: 0; margin-left: 16px; font-size: 16px; color: #0a1324; }
.cell-value {
  max-width: 46%;
  margin-left: 8px;
  font-size: 13px;
  color: #5a6b85;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.chevron { margin-left: 8px; color: #5a6b85; font-size: 18px; line-height: 1; }
.me-footnote { margin: 18px 16px 24px; text-align: center; font-size: 11px; color: #5a6b85; }

.attachment {
  display: flex;
  flex-direction: column;
  margin: 8px 0;
}

.attachment-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 10px;
}

.attachment-video {
  width: 100%;
  border-radius: 10px;
}

.attachment-file {
  background: #e6edf8;
  border-radius: 10px;
  padding: 10px 12px;
  color: #0a5cff;
  font-size: 13px;
}
