page{background:#f3f6fc;color:#101828;font-family:system-ui,-apple-system,sans-serif}.card{background:#fff;border:1px solid #dbe2ef;border-radius:14px;padding:16px;margin:12px}.h1{font-size:20px;font-weight:600;margin:4px 0}.muted{color:#5a6478;font-size:13px;line-height:1.5}.row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #eef2f8;font-size:14px}.badge{padding:2px 8px;border-radius:999px;font-size:11px;background:#ecfdf3;color:#067647}.badge.warn{background:#fffaeb;color:#b54708}.input{flex:1;border:1px solid #dbe2ef;border-radius:8px;padding:8px;margin-right:8px}.btn{background:#2563eb;color:#fff;border-radius:8px;padding:8px 14px;font-size:14px}
