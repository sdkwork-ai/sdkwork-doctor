/* Tech-blue, flat, borderless. Values pinned by specs/design-tokens.contract.json. */
page {
  background: #f2f5fa;
  color: #0a1324;
  font-family: 'Inter', system-ui, -apple-system, sans-serif;

  /* Shared conversation composer (appbase projection) bound to the tokens. */
  --sdkwork-chat-composer-accent: #0a5cff;
  --sdkwork-chat-composer-chip: #e6edf8;
  --sdkwork-chat-composer-disabled-control: #e6edf8;
  --sdkwork-chat-composer-foreground: #0a1324;
  --sdkwork-chat-composer-on-accent: #ffffff;
  --sdkwork-chat-composer-placeholder: #5a6b85;
  --sdkwork-chat-composer-radius-card: 14px;
  --sdkwork-chat-composer-surface: #ffffff;
}

.card {
  background: #ffffff;
  border: 0;
  border-radius: 14px;
  padding: 16px;
  margin: 12px;
}

.h1 { font-size: 20px; font-weight: 600; margin: 4px 0; color: #0a1324; }
.muted { color: #5a6b85; font-size: 13px; line-height: 1.6; }

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 12px;
  margin: 6px 0;
  border-radius: 10px;
  background: #e6edf8;
  font-size: 14px;
}

.record {
  background: #e6edf8;
  border-radius: 10px;
  padding: 10px 12px;
  margin: 8px 0;
}

.badge {
  padding: 3px 9px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 600;
  background: #e3f7ef;
  color: #0e9f6e;
}
.badge.warn { background: #fff4e0; color: #b26a00; }

.input {
  flex: 1;
  background: #e6edf8;
  border: 0;
  border-radius: 10px;
  padding: 10px;
  margin-right: 8px;
  color: #0a1324;
}

.btn {
  background: #0a5cff;
  color: #ffffff;
  border-radius: 10px;
  padding: 10px 16px;
  font-size: 14px;
  font-weight: 600;
}
.btn[disabled] { opacity: 0.55; }

.error { color: #e5484d; font-size: 12px; }
