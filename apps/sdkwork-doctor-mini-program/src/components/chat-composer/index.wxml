<!-- @generated by tools/generate-chat-composer.mjs from sdkwork-appbase/packages/mini-program/foundation/sdkwork-chat-composer-mini-program/src/components/chat-composer - do not edit. -->
<view class="sc-chat-composer sc-chat-composer--{{expanded ? 'expanded' : 'idle'}} {{disabled ? 'sc-chat-composer--disabled' : ''}} custom-class">
  <view class="sc-chat-composer__card">
    <view
      aria-role="button"
      aria-label="{{voiceLabel}}"
      class="sc-chat-composer__voice {{disabled || !voiceEnabled ? 'sc-chat-composer__slot--muted' : ''}} {{voiceActive ? 'sc-chat-composer__voice--active' : ''}}"
      bindtouchstart="onVoiceStart"
      bindtouchcancel="onVoiceEnd"
      bindtouchend="onVoiceEnd"
    >
      <view class="sc-chat-composer__wave">
        <view class="sc-chat-composer__wave-dot"></view>
        <view class="sc-chat-composer__wave-arc sc-chat-composer__wave-arc--small"></view>
        <view class="sc-chat-composer__wave-arc"></view>
      </view>
    </view>

    <view class="sc-chat-composer__field">
      <textarea
        class="sc-chat-composer__input"
        auto-height="{{true}}"
        bindblur="onBlur"
        bindconfirm="onConfirm"
        bindfocus="onFocus"
        bindinput="onInput"
        confirm-type="send"
        cursor-spacing="24"
        disabled="{{disabled}}"
        maxlength="{{maxlength}}"
        placeholder="{{placeholder}}"
        placeholder-class="sc-chat-composer__placeholder"
        show-confirm-bar="{{false}}"
        value="{{draft}}"
      />
    </view>

    <view
      wx:if="{{modeLabel}}"
      aria-role="button"
      aria-label="{{modeLabel}}"
      class="sc-chat-composer__mode {{disabled ? 'sc-chat-composer__slot--muted' : ''}}"
      bindtap="onModeTap"
    >
      <view class="sc-chat-composer__bolt"></view>
      <text class="sc-chat-composer__mode-label">{{modeLabel}}</text>
      <view wx:if="{{modeSelectable}}" class="sc-chat-composer__caret"></view>
    </view>

    <view class="sc-chat-composer__spacer"></view>

    <view
      aria-role="button"
      aria-label="{{attachLabel}}"
      class="sc-chat-composer__attach {{disabled || !attachEnabled ? 'sc-chat-composer__slot--muted' : ''}}"
      bindtap="onAttach"
    >
      <view class="sc-chat-composer__plus"></view>
    </view>

    <view
      aria-role="button"
      aria-label="{{sendLabel}}"
      class="sc-chat-composer__send {{busy || disabled ? 'sc-chat-composer__send--disabled' : ''}}"
      bindtap="submit"
    >
      <view wx:if="{{busy}}" class="sc-chat-composer__spinner"></view>
      <view wx:else class="sc-chat-composer__arrow"></view>
    </view>
  </view>
</view>
