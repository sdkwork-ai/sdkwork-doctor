{
  "name": "@sdkwork/doctor-h5",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SDKWork Doctor H5 mobile browser application.",
  "scripts": {
    "dev": "node ../../scripts/dev-surface.mjs --surface h5 --mode standalone.development",
    "dev:standalone": "node ../../scripts/dev-surface.mjs --surface h5 --mode standalone.development",
    "dev:cloud": "node ../../scripts/dev-surface.mjs --surface h5 --mode cloud.development",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/h5-surface.test.mjs",
    "check": "pnpm typecheck && pnpm test",
    "clean": "node ../../scripts/clean-dist.mjs --surface h5"
  },
  "dependencies": {
    "@sdkwork/doctor-common-diagnostics": "workspace:*",
    "@sdkwork/doctor-h5-commons": "workspace:*",
    "@sdkwork/doctor-h5-core": "workspace:*",
    "@sdkwork/doctor-h5-diagnostics": "workspace:*",
    "@sdkwork/doctor-h5-shell": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.3.0"
  }
}
