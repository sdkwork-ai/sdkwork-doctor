**/.sdkwork/tmp/
**/.sdkwork/cache/
**/.sdkwork/secrets/
**/.sdkwork/manual-backups/

# Compiler emit is never tracked beside source; only map files are ignored by pattern.
*.js.map
*.d.ts.map

# Logs and OS noise
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# Playwright and test artifacts
test-results/
playwright-report/

# Flutter
.dart_tool/
**/.dart_tool/
**/build/

